{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["replicas", "image", "cluster", "slackChannelId", "infraSlackIds"],
  "properties": {
    "replicas": {"type": "integer", "enum": [0, 1]},
    "image": {"type": "string", "minLength": 1},
    "cluster": {"type": "string"},
    "slackChannelId": {"type": "string"},
    "infraSlackIds": {"type": "string"}
  },
  "allOf": [{
    "if": {"properties": {"replicas": {"const": 1}}},
    "then": {
      "properties": {
        "cluster": {"minLength": 1},
        "slackChannelId": {"pattern": "^[CG][A-Z0-9]+$"},
        "infraSlackIds": {"pattern": "^[UW][A-Z0-9]+(\\s+[UW][A-Z0-9]+)*$"}
      }
    }
  }]
}
